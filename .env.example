# Copy to .env.local (git-ignored). Variables prefixed VITE_ are built into the bundle.

# Backend origin, e.g. https://api.example.com. Leave empty when the API is served on the same
# origin as this app (or behind a reverse proxy at /api). The backend must list this app's
# origin in its ALLOWED_ORIGINS and set DASHBOARD_BASE_URL to it (OAuth returns land there).
VITE_API_ORIGIN=

# Dev server only: forward /api, /healthz and /readyz to this backend so the browser stays
# same-origin. Example: http://127.0.0.1:8000
DEV_API_PROXY_TARGET=

# End-to-end tests (pnpm e2e). Optional ones are listed in the README.
E2E_API_URL=
E2E_FAKE_MARKETPLACE_URL=
E2E_BACKEND_DIR=
